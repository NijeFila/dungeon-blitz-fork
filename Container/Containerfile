FROM node:24-bookworm-slim AS build

WORKDIR /build/src/server
COPY src/server/package.json src/server/package-lock.json ./
RUN npm ci --ignore-scripts
COPY src/server ./
COPY src/client /build/src/client
RUN npm run build

FROM node:24-bookworm-slim

# Main port
EXPOSE 8000/tcp
EXPOSE 8080/tcp
EXPOSE 843/tcp

ENV NODE_ENV=production \
    STATIC_PORT=8000
WORKDIR /opt/games/dungeon-blitz-r/src/server

COPY src/server/package.json src/server/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /build/src/server/dist ./dist
COPY --from=build /build/src/server/data ./data
COPY --from=build /build/src/client/content/localhost /opt/games/dungeon-blitz-r/src/client/content/localhost
COPY package.json /opt/games/dungeon-blitz-r/package.json

# entrypoint.sh
COPY Container/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && \
    sed -i -e 's/\r$//' /usr/local/bin/entrypoint.sh && \
    mkdir -p data/saves && chown -R node:node /opt/games/dungeon-blitz-r

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8000/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

USER node

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
