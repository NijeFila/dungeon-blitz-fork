    "data:scheduled-backup": "node tools/scheduledRuntimeBackup.js",
    "migrate:game-data-to-mongo": "node --env-file-if-exists=.env -r ts-node/register scripts/migrate_game_data_to_mongo.ts",
    "admin": "node --env-file-if-exists=.env tools/adminPanelServer.js"
  },
  "keywords": [],
