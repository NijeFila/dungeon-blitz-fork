    "patch:gear-227-critical-power": "ts-node scripts/patch_gameswz_gear_227_critical_power.ts",
    "patch:gear-1116-1123-stats-runes": "ts-node scripts/patch_gameswz_gear_1116_1123_stats_runes.ts",
    "patch:power-mana-costs": "ts-node scripts/patch_gameswz_power_mana_costs.ts",
    "patch:english-text": "ts-node scripts/patch_gameswz_english_text.ts",
    "patch:bandit-camp-text": "ts-node scripts/patch_bandit_camp_text.ts",
